VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Groq — TYLKO po stronie serwera (Vite proxy lokalnie / Vercel Function w prod), BEZ VITE_
GROQ_API_KEY=
# Preferowany model (frontend); fallback 120b→20b jest w kodzie
VITE_GROQ_MODEL=openai/gpt-oss-120b

# --- Vercel (Project → Settings → Environment Variables) ---
# VITE_SUPABASE_URL
# VITE_SUPABASE_ANON_KEY
# VITE_GROQ_MODEL
# GROQ_API_KEY          ← Secret, Production + Preview
# W Supabase Auth: dodaj URL produkcji do Redirect URLs / Site URL
